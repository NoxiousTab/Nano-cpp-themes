## Monokai Pro -- GNU nano theme for C++  (Rich spectrum on warm graphite)
## Recommended terminal colours: background #2d2a2e, foreground #fcfcfa (set in your terminal profile; nano cannot paint them).
## Uses only nano's named colours, so it parses on nano 7.2 (which rejects numeric and #hex colours).
## Needs a 256-colour terminal (TERM=xterm-256color). black / lightwhite follow your terminal palette.

## Interface
set titlecolor black,sand
set statuscolor black,sand
set selectedcolor black,peach
set spotlightcolor black,peach
set keycolor black,sand
set numbercolor slate

## Role palette
##   cmt   slate      Comments
##   kw    pink       Keywords
##   type  lagoon     Fundamental types
##   func  sage       Function names
##   cls   lagoon     Class names
##   ns    sky        Namespaces
##   str   sand       Strings and chars
##   num   sky        Numbers
##   const sky        Constants and macros
##   op    pink       Operators
##   punct lightwhite Punctuation
##   pp    peach      Preprocessor
##   hdr   sand       Include paths
##   std   lagoon     Standard library
##   esc   peach      Escapes
##   todo  peach      TODO tags

syntax "cpp-monokai" "\.(cc|cpp|cxx|hh|hpp|hxx|h|ino)$"

color pink "[-+*/%=<>!&|^~?:]+"
color sky "\<[A-Za-z_][A-Za-z0-9_]*::"
color sage "\<[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\("
color lightwhite "[][(){};,.]"
color lagoon "\<[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\>"
color sky "\<(true|false|nullptr|NULL|k[A-Z][A-Za-z0-9]*|[A-Z][A-Z0-9_]{2,})\>"
color lagoon "\<(auto|bool|char|double|float|int|long|short|signed|unsigned|void|wchar_t|char8_t|char16_t|char32_t|size_t|ssize_t|ptrdiff_t|u?int(8|16|32|64)_t)\>"
color lagoon "\<(std|cout|cin|cerr|endl|vector|string|string_view|map|unordered_map|set|unordered_set|list|deque|array|pair|tuple|optional|variant|unique_ptr|shared_ptr|weak_ptr|make_unique|make_shared|move|forward|function|ostream|istream|stringstream|thread|mutex)\>"
color pink "\<(alignas|alignof|and|asm|break|case|catch|class|const|consteval|constexpr|constinit|const_cast|continue|co_await|co_return|co_yield|decltype|default|delete|do|dynamic_cast|else|enum|explicit|export|extern|final|for|friend|goto|if|inline|mutable|namespace|new|noexcept|not|operator|or|override|private|protected|public|register|reinterpret_cast|requires|return|sizeof|static|static_assert|static_cast|struct|switch|template|this|thread_local|throw|try|typedef|typeid|typename|union|using|virtual|volatile|while|xor)\>"
color sky "\<[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?[fFlL]?\>"
color sky "\<[0-9]+[uUlL]*\>"
color sky "\<0[xX][0-9a-fA-F]+[uUlL]*\>"
color sand "^[[:space:]]*#[[:space:]]*include[[:space:]]+[<"][^>"]+[>"]"
color peach "^[[:space:]]*#[[:space:]]*(include|define|undef|ifdef|ifndef|if|else|elif|endif|pragma|error|warning)\>"
color sand ""(\\.|[^"])*""
color sand "'(\\.|[^'\\])'"
color peach "\\[abfnrtv0\\"']"
color slate "//.*"
color slate start="/\*" end="\*/"
color peach "(TODO|FIXME|XXX|NOTE|HACK)"
color ,red "[[:space:]]+$"
