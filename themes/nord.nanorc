## Nord -- GNU nano theme for C++  (Arctic blues and quiet grays)
## Recommended terminal colours: background #2e3440, foreground #d8dee9 (set in your terminal profile; nano cannot paint them).
## Uses only nano's named colours, so it parses on nano 7.2 (which rejects numeric and #hex colours).
## Needs a 256-colour terminal (TERM=xterm-256color). black / lightwhite follow your terminal palette.

## Interface
set titlecolor black,lagoon
set statuscolor black,lagoon
set selectedcolor black,sand
set spotlightcolor black,sand
set keycolor black,lagoon
set numbercolor slate

## Role palette
##   cmt   slate      Comments
##   kw    lagoon     Keywords
##   type  latte      Fundamental types
##   func  lightwhite Function names
##   cls   lagoon     Class names
##   ns    lightwhite Namespaces
##   str   sage       Strings and chars
##   num   rosy       Numbers
##   const rosy       Constants and macros
##   op    lagoon     Operators
##   punct lightwhite Punctuation
##   pp    latte      Preprocessor
##   hdr   sage       Include paths
##   std   lagoon     Standard library
##   esc   sand       Escapes
##   todo  sand       TODO tags

syntax "cpp-nord" "\.(cc|cpp|cxx|hh|hpp|hxx|h|ino)$"

color lagoon "[-+*/%=<>!&|^~?:]+"
color lightwhite "\<[A-Za-z_][A-Za-z0-9_]*::"
color lightwhite "\<[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\("
color lightwhite "[][(){};,.]"
color lagoon "\<[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\>"
color rosy "\<(true|false|nullptr|NULL|k[A-Z][A-Za-z0-9]*|[A-Z][A-Z0-9_]{2,})\>"
color latte "\<(auto|bool|char|double|float|int|long|short|signed|unsigned|void|wchar_t|char8_t|char16_t|char32_t|size_t|ssize_t|ptrdiff_t|u?int(8|16|32|64)_t)\>"
color lagoon "\<(std|cout|cin|cerr|endl|vector|string|string_view|map|unordered_map|set|unordered_set|list|deque|array|pair|tuple|optional|variant|unique_ptr|shared_ptr|weak_ptr|make_unique|make_shared|move|forward|function|ostream|istream|stringstream|thread|mutex)\>"
color lagoon "\<(alignas|alignof|and|asm|break|case|catch|class|const|consteval|constexpr|constinit|const_cast|continue|co_await|co_return|co_yield|decltype|default|delete|do|dynamic_cast|else|enum|explicit|export|extern|final|for|friend|goto|if|inline|mutable|namespace|new|noexcept|not|operator|or|override|private|protected|public|register|reinterpret_cast|requires|return|sizeof|static|static_assert|static_cast|struct|switch|template|this|thread_local|throw|try|typedef|typeid|typename|union|using|virtual|volatile|while|xor)\>"
color rosy "\<[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?[fFlL]?\>"
color rosy "\<[0-9]+[uUlL]*\>"
color rosy "\<0[xX][0-9a-fA-F]+[uUlL]*\>"
color sage "^[[:space:]]*#[[:space:]]*include[[:space:]]+[<"][^>"]+[>"]"
color latte "^[[:space:]]*#[[:space:]]*(include|define|undef|ifdef|ifndef|if|else|elif|endif|pragma|error|warning)\>"
color sage ""(\\.|[^"])*""
color sage "'(\\.|[^'\\])'"
color sand "\\[abfnrtv0\\"']"
color slate "//.*"
color slate start="/\*" end="\*/"
color sand "(TODO|FIXME|XXX|NOTE|HACK)"
color ,red "[[:space:]]+$"
