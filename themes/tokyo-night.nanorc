## Tokyo Night -- GNU nano theme for C++  (Midnight blue with cool neon accents)
## Recommended terminal colours: background #1a1b26, foreground #c0caf5 (set in your terminal profile; nano cannot paint them).
## Uses only nano's named colours, so it parses on nano 7.2 (which rejects numeric and #hex colours).
## Needs a 256-colour terminal (TERM=xterm-256color). black / lightwhite follow your terminal palette.

## Interface
set titlecolor black,sky
set statuscolor black,sky
set selectedcolor black,peach
set spotlightcolor black,peach
set keycolor black,sky
set numbercolor slate

## Role palette
##   cmt   slate      Comments
##   kw    sky        Keywords
##   type  lagoon     Fundamental types
##   func  sea        Function names
##   cls   lagoon     Class names
##   ns    peach      Namespaces
##   str   sage       Strings and chars
##   num   peach      Numbers
##   const peach      Constants and macros
##   op    lagoon     Operators
##   punct sky        Punctuation
##   pp    lagoon     Preprocessor
##   hdr   sage       Include paths
##   std   lagoon     Standard library
##   esc   lagoon     Escapes
##   todo  peach      TODO tags

syntax "cpp-tokyo-night" "\.(cc|cpp|cxx|hh|hpp|hxx|h|ino)$"

color lagoon "[-+*/%=<>!&|^~?:]+"
color peach "\<[A-Za-z_][A-Za-z0-9_]*::"
color sea "\<[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\("
color sky "[][(){};,.]"
color lagoon "\<[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\>"
color peach "\<(true|false|nullptr|NULL|k[A-Z][A-Za-z0-9]*|[A-Z][A-Z0-9_]{2,})\>"
color lagoon "\<(auto|bool|char|double|float|int|long|short|signed|unsigned|void|wchar_t|char8_t|char16_t|char32_t|size_t|ssize_t|ptrdiff_t|u?int(8|16|32|64)_t)\>"
color lagoon "\<(std|cout|cin|cerr|endl|vector|string|string_view|map|unordered_map|set|unordered_set|list|deque|array|pair|tuple|optional|variant|unique_ptr|shared_ptr|weak_ptr|make_unique|make_shared|move|forward|function|ostream|istream|stringstream|thread|mutex)\>"
color sky "\<(alignas|alignof|and|asm|break|case|catch|class|const|consteval|constexpr|constinit|const_cast|continue|co_await|co_return|co_yield|decltype|default|delete|do|dynamic_cast|else|enum|explicit|export|extern|final|for|friend|goto|if|inline|mutable|namespace|new|noexcept|not|operator|or|override|private|protected|public|register|reinterpret_cast|requires|return|sizeof|static|static_assert|static_cast|struct|switch|template|this|thread_local|throw|try|typedef|typeid|typename|union|using|virtual|volatile|while|xor)\>"
color peach "\<[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?[fFlL]?\>"
color peach "\<[0-9]+[uUlL]*\>"
color peach "\<0[xX][0-9a-fA-F]+[uUlL]*\>"
color sage "^[[:space:]]*#[[:space:]]*include[[:space:]]+[<"][^>"]+[>"]"
color lagoon "^[[:space:]]*#[[:space:]]*(include|define|undef|ifdef|ifndef|if|else|elif|endif|pragma|error|warning)\>"
color sage ""(\\.|[^"])*""
color sage "'(\\.|[^'\\])'"
color lagoon "\\[abfnrtv0\\"']"
color slate "//.*"
color slate start="/\*" end="\*/"
color peach "(TODO|FIXME|XXX|NOTE|HACK)"
color ,red "[[:space:]]+$"
